{
    "name": "workflow-generator",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
        "dev:server": "tsx watch src/server/index.ts",
        "dev:client": "vite",
        "build": "vite build && tsc -p tsconfig.server.json",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@langchain/core": "^0.3.0",
        "@langchain/google-genai": "^0.2.17",
        "@langchain/langgraph": "^0.2.74",
        "@vue-flow/core": "^1.41.0",
        "@vue-flow/background": "^1.3.0",
        "@vue-flow/controls": "^1.1.0",
        "@vue-flow/minimap": "^1.5.0",
        "express": "^5.0.0",
        "cors": "^2.8.5",
        "vue": "^3.5.0",
        "vue-router": "^4.4.0",
        "pinia": "^2.2.0",
        "zod": "^3.23.0",
        "lodash": "^4.17.21"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/lodash": "^4.17.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^5.2.0",
        "concurrently": "^9.0.0",
        "sass": "^1.80.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vite": "^6.0.0",
        "vue-tsc": "^2.2.0"
    },
    "engines": {
        "node": ">=20"
    }
}